@echo off
powershell -NoProfile -ExecutionPolicy Bypass -Command "Add-Type -AssemblyName System.IO.Compression.FileSystem; Get-ChildItem -Path . -Recurse -Filter '*.xwb.zip.001' | ForEach-Object { $firstPart = $_.FullName; $dir = $_.DirectoryName; $zipPath = $firstPart -replace '\.001$', ''; Write-Host 'Decompressing split archive:' $zipPath; $partFiles = Get-ChildItem -Path ($zipPath + '.*') | Where-Object { $_.Name -match '\.\d{3}$' } | Sort-Object Name; try { $dest = [System.IO.File]::Create($zipPath); foreach ($part in $partFiles) { $bytes = [System.IO.File]::ReadAllBytes($part.FullName); $dest.Write($bytes, 0, $bytes.Length) }; $dest.Close(); $zip = [System.IO.Compression.ZipFile]::OpenRead($zipPath); foreach ($entry in $zip.Entries) { $outPath = [System.IO.Path]::Combine($dir, $entry.FullName); [System.IO.Compression.ZipFileExtensions]::ExtractToFile($entry, $outPath, $true) }; $zip.Dispose(); $partFiles | Remove-Item -Force; Remove-Item $zipPath -Force } catch { Write-Error ('Extraction failed for ' + $zipPath + ': ' + $_); if (Test-Path $zipPath) { Remove-Item $zipPath -Force } } }; Get-ChildItem -Path . -Recurse -Filter '*.xwb.zip' | ForEach-Object { $zipPath = $_.FullName; $dir = $_.DirectoryName; Write-Host 'Decompressing:' $zipPath; try { $zip = [System.IO.Compression.ZipFile]::OpenRead($zipPath); foreach ($entry in $zip.Entries) { $outPath = [System.IO.Path]::Combine($dir, $entry.FullName); [System.IO.Compression.ZipFileExtensions]::ExtractToFile($entry, $outPath, $true) }; $zip.Dispose(); Remove-Item $zipPath -Force } catch { Write-Error ('Extraction failed for ' + $zipPath + ': ' + $_) } }"
echo.
pause